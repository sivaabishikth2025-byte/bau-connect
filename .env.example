NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# Optional: free CARTO key for Streets/Light/Dark styles — https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_API_KEY=

# Google Maps (map page) — enable Maps JavaScript API + Places API in Google Cloud
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_BAU_INTERACTIVE_MAP_URL=https://your-bau-interactive-map-url
# Local: http://localhost:3000  Production: https://baustudentconnect.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only this BAU login sees Admin and can post volunteer requirements
NEXT_PUBLIC_VOLUNTEER_ADMIN_EMAIL=smylavarapu@stu.bau.edu

# AWS SES email notifications
# Local: AWS_* works. On Netlify those names are reserved, so use SES_* there.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SES_ACCESS_KEY_ID=your_aws_access_key_id
SES_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Must be a verified SES identity (email or domain)
SES_FROM_EMAIL=BAU Connect <notifications@baustudentconnect.com>
