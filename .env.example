NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# Optional: free CARTO key for Streets/Light/Dark styles — https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_API_KEY=

# Google Maps (map page) — enable Maps JavaScript API + Places API in Google Cloud
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Local-only (never commit). Used by scripts/firebase-cli-auth.mjs for admin setup scripts.
# FIREBASE_CLI_CLIENT_SECRET=

NEXT_PUBLIC_BAU_INTERACTIVE_MAP_URL=https://your-bau-interactive-map-url
# Local: http://localhost:3000  Production: https://baustudentconnect.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only this BAU login sees Admin and can post volunteer requirements
NEXT_PUBLIC_VOLUNTEER_ADMIN_EMAIL=smylavarapu@stu.bau.edu

# Email (Brevo) — free 300/day, no credit card — https://www.brevo.com
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAIL_FROM=BAU Connect <notifications@baustudentconnect.com>
# Required for verification + password reset links (Firebase Admin JSON)
FIREBASE_SERVICE_ACCOUNT=
